# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env никому не отправляйте и не коммитьте.

TELEGRAM_TOKEN=123456789:ABCdef...
PROXY_URL=socks5://127.0.0.1:10808

# что пускать через прокси: yt (YouTube Music), sc (SoundCloud), tg (сам Telegram)
# PROXY_SOURCES=yt,sc,tg
# FFMPEG_LOCATION=C:\ffmpeg\bin
# SOURCES=yt,sc
